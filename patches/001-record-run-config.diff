+# Record the full run configuration alongside the outputs.
+# run_slam.py otherwise writes only timing (info.txt), which makes a
+# completed experiment impossible to reproduce after the fact.
+import json as _json
+import os as _os
+_run_dir = _os.path.join(args.output_folder, args.name)
+_os.makedirs(_run_dir, exist_ok=True)
+with open(_os.path.join(_run_dir, 'args.json'), 'w') as _f:
+    _json.dump(vars(args), _f, indent=2, sort_keys=True)
